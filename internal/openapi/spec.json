  "components": {
    "securitySchemes": {
      "managementToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Management token from the `Upload-Management-Token` header (tus) or `management_token` (MCP). For `DELETE /files/{id}` it may also be sent in the `Upload-Management-Token` header."
      },
      "filePassword": {
        "type": "http",
        "scheme": "basic",
        "description": "Password of a protected file as the Basic auth password; the username is ignored (`curl -u :secret`)."
      }
    },
    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Upload ID. Either the object ID (`/files/{objectId}/…` in share links) or the full tus ID from `Location` (`{objectId}+{multipartId}`).",
        "schema": {
          "type": "string"
        },
        "example": "0b5d4e8f608768ca0189eb430e63f513"
      },
      "filename": {
        "name": "filename",
        "in": "path",
        "required": true,
        "description": "Cosmetic filename; ignored when serving.",
        "schema": {
          "type": "string"
        },
        "example": "report.pdf"
      },
      "tusResumable": {
        "name": "Tus-Resumable",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "1.0.0"
          ]
        }
      }
    },
    "schemas": {
      "FileInfo": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string",
            "description": "Full upload ID"
          },
          "filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer"
          },
          "complete": {
            "type": "boolean",
            "description": "Whether all bytes have been received"
          },
          "download_url": {
            "type": "string",
            "format": "uri",
            "description": "Share link: `/files/{objectId}/{filename}`"
          },
          "direct_download_url": {
            "type": "string",
            "format": "uri",
            "description": "Always downloads: `/dl/{objectId}/{filename}`"
          },
          "expires_at": {
            "type": "string",
            "description": "RFC 3339 time; empty until the upload completes"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "inline",
              "attachment"
            ]
          },
          "password_protected": {
            "type": "boolean"
          }
        },
        "example": {
          "file_id": "0b5d4e8f608768ca0189eb430e63f513+01M3H2KRTJPDWG3V1WKSM5V8G2",
          "filename": "report.pdf",
          "content_type": "application/pdf",
          "size_bytes": 48213,
          "complete": true,
          "download_url": "https://share.mk/files/0b5d4e8f608768ca0189eb430e63f513/report.pdf",
          "direct_download_url": "https://share.mk/dl/0b5d4e8f608768ca0189eb430e63f513/report.pdf",
          "expires_at": "2026-10-04T12:00:00Z",
          "disposition": "inline",
          "password_protected": false
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "example": {
          "error": "file not found"
        }
      }
    }
  }
}
