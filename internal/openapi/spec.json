    "/mcp": {
      "post": {
        "tags": [
          "MCP"
        ],
        "summary": "MCP Streamable HTTP (JSON-RPC)",
        "operationId": "mcp",
        "description": "Model Context Protocol endpoint for AI assistants. Tools:\n\n- `upload_file(filename, content (base64), content_type?, expires_in?, password?, disposition?)` → `file_id`, `management_token`, `manage_url`, `download_url`, `direct_download_url`, `expires_at`, `filename`, `size_bytes`, `password_protected`\n- `get_file_info(file_id, management_token)` → same fields as `GET /api/files/{id}`\n- `delete_file(file_id, management_token)` → `deleted`, `file_id`\n\nStart with `initialize`; send the returned `Mcp-Session-Id` header on later requests. Request bodies are limited to 16 MiB (about 12 MB of file content after base64); use tus for larger files. Full instructions: [/llms.txt](/llms.txt).",
        "parameters": [
          {
            "name": "Mcp-Session-Id",
            "in": "header",
            "description": "Session ID from the initialize response",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "tools/call",
                "params": {
                  "name": "upload_file",
                  "arguments": {
                    "filename": "hello.txt",
                    "content": "aGVsbG8=",
                    "expires_in": "1h"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response",
            "headers": {
              "Mcp-Session-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON-RPC or unknown session"
          },
          "413": {
            "description": "Request body larger than 16 MiB"
          },
          "429": {
            "description": "Too many concurrent MCP requests from this IP or overall"
          }
        }
      },
      "get": {
        "tags": [
          "MCP"
        ],
        "summary": "MCP server-to-client event stream",
        "operationId": "mcpStream",
        "parameters": [
          {
            "name": "Mcp-Session-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Server-sent events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "MCP"
        ],
        "summary": "End an MCP session",
        "operationId": "mcpEndSession",
        "parameters": [
          {
            "name": "Mcp-Session-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session ended"
          }
        }
      }
    },
