# ── S3 / Scaleway Object Storage ─────────────────────────────────────────────
S3_BUCKET=files1
S3_REGION=fr-par
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_ACCESS_KEY=your-access-key-id
S3_SECRET_KEY=your-secret-access-key
S3_OBJECT_PREFIX=uploads/

# ── Resumable upload ──────────────────────────────────────────────────────────
TUS_BASE_PATH=/files/
# 10 GiB
TUS_MAX_SIZE=10737418240

# ── Server ────────────────────────────────────────────────────────────────────
# Bind to loopback when a reverse proxy (Caddy) runs on the same host, so the
# app is not reachable directly over plain HTTP.
SERVER_ADDR=127.0.0.1:8080

# Public-facing base URL used to build download links returned by the MCP tools.
# No trailing slash.
PUBLIC_URL=https://share.mk

# ── Rate limiting ─────────────────────────────────────────────────────────────
# max concurrent uploads across all IPs
RATE_LIMIT_GLOBAL=50
# max concurrent uploads per IP
RATE_LIMIT_PER_IP=5
# Proxies whose X-Forwarded-For is trusted for the client IP (comma-separated).
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ── MCP limits ────────────────────────────────────────────────────────────────
MCP_MAX_BODY_BYTES=16777216
MCP_RATE_LIMIT_GLOBAL=10
MCP_RATE_LIMIT_PER_IP=2

# ── Cleanup ───────────────────────────────────────────────────────────────────
# Unfinished uploads idle longer than this are removed.
INCOMPLETE_UPLOAD_TTL=48h

# ── Logging: info | debug ─────────────────────────────────────────────────────
LOG_LEVEL=info
